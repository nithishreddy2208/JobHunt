# ──────────────────────────────────────────────────────────────
# JobHunt Backend — Environment Variables
# Copy this file to ".env" and fill in real values.
# ──────────────────────────────────────────────────────────────

# Runtime environment: "development" | "production"
# Controls CORS defaults, ClamAV default, and worker behavior.
NODE_ENV=development

# HTTP port the API server listens on (Render injects PORT automatically).
PORT=8000

# ── Database (MongoDB Atlas SRV URI) ──────────────────────────
MONGO_URI=your_mongodb_connection_string

# ── Auth ──────────────────────────────────────────────────────
SECRET_KEY=your_jwt_secret_key

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allow-list. OVERRIDES the environment defaults below.
# Defaults when unset:
#   development -> http://localhost:5173,http://localhost:3000
#   production  -> https://jobhunt-frontend-three.vercel.app
# Example (production):
# CORS_ORIGINS=https://jobhunt-frontend-three.vercel.app
CORS_ORIGINS=

# ── Redis (cache + BullMQ) ────────────────────────────────────
# Local: redis://localhost:6379
# Upstash (TLS): rediss://:PASSWORD@xxxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379
JOB_CACHE_TTL_SECONDS=300

# ── Trie autocomplete refresh ─────────────────────────────────
# If unset, the Trie loads once at startup; set ms to refresh periodically.
JOB_TRIE_REFRESH_MS=600000

# ── MongoDB replica-set tuning ────────────────────────────────
READ_PREFERENCE=secondaryPreferred
DB_POOL_SIZE_MAX=20
DB_POOL_SIZE_MIN=2
DB_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=45000
# Optional dedicated read-connection pool
# DB_READ_POOL_SIZE_MAX=20
# DB_READ_POOL_SIZE_MIN=2

# ── ClamAV virus scanning (uploads) ───────────────────────────
# Requires a local clamd daemon (Docker) on CLAMAV_HOST:CLAMAV_PORT.
# Default behavior: ENABLED in development, DISABLED in production
# (Render has no clamd). Set CLAMAV_ENABLED to override explicitly.
# CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000

# ── BullMQ workers ────────────────────────────────────────────
# Inline workers run inside the API web process (no separate worker service).
# Default when UNSET:
#   - production (NODE_ENV=production): ENABLED  (Render free tier has no
#     Background Worker service, so workers must live in the web process)
#   - development: DISABLED (nodemon hot-reload leaks blocking Redis polls)
# Set explicitly to true/false to override the default for the current env.
# WORKERS_INLINE=true
TASKS_WORKER_CONCURRENCY=2

# ── AI / LLM (OpenRouter primary, Ollama fallback) ────────────
# IMPORTANT: variable names must match exactly what the code reads
# (services/openrouter.service.js + services/llm.service.js):
#   OPEN_ROUTER_API_KEY      (NOT OPENROUTER_API_KEY)
#   OPEN_ROUTER_MODEL_NAME   (NOT OPENROUTER_MODEL)
# If the key is missing/misnamed, OpenRouter is silently skipped and every AI
# feature falls back to Ollama — which is not available on Render.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL_NAME=meta-llama/llama-3.1-8b-instruct
# Optional OpenRouter attribution headers
OPEN_ROUTER_REFERER=https://jobhunt-frontend-three.vercel.app
OPEN_ROUTER_APP_TITLE=JobHunt
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi
LLM_TIMEOUT_MS=60000
AI_CACHE_TTL_SECONDS=900
# Recruiter AI cache TTL overrides (optional)
AI_SUMMARY_TTL_SECONDS=86400
AI_SHORTLIST_TTL_SECONDS=1800

# ── Cloudinary (resume + photo uploads) ───────────────────────
# IMPORTANT: variable names must match exactly what utils/cloudinary.js reads:
#   CLOUD_NAME      (NOT CLOUDINARY_CLOUD_NAME)
#   API_KEY         (NOT CLOUDINARY_API_KEY)
#   API_SECRET      (NOT CLOUDINARY_API_SECRET)
# If misnamed, uploads will fail with "Missing Cloudinary credentials".
CLOUD_NAME=
API_KEY=
API_SECRET=

# ── Freemium limits (FREE tier only; PRO bypasses) ────────────
AI_FREE_DAILY_LIMIT=3
APPLICATION_FREE_DAILY_LIMIT=5
